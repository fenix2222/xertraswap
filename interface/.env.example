# Xertra Swap Environment Configuration
# Copy this file to .env.local for local development

# Chain ID (105105 = mainnet, 205205 = testnet/Auroria)
REACT_APP_CHAIN_ID=105105

# RPC URL for the target network
# Mainnet: https://rpc.stratisevm.com
# Testnet: https://auroria.rpc.stratisevm.com
REACT_APP_NETWORK_URL=https://rpc.stratisevm.com

# Web3Auth configuration
REACT_APP_WEB3AUTH_CLIENT_ID=BMdNL0PvfLFjZ7xMac75rae_xRHywJxQWDCa1WXmjodl8kZK7-g4lTiafTdqU88w0Ww2tpahqBmpJOrLq1So--8
# sapphire_mainnet or sapphire_devnet
REACT_APP_WEB3AUTH_NETWORK=sapphire_mainnet
