{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["dom", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "jsx": "react",
    "types": ["react", "react-dom", "styled-components", "react-router-dom", "react-transition-group", "lodash", "styled-system", "jest", "testing-library__jest-dom"]
  },
  "include": ["src"],
  "exclude": ["node_modules", "src/**/*.stories.tsx", "src/__tests__/**/*"]
}
